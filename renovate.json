{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "repositories": [
        "Winnetou/uv_repo"
    ],
    "extends": [
      "config:recommended"
    ],
    "onboarding": false,
    "requireConfig": "optional",
    "branchPrefix": "renovate-py/",
    "poetry": {
    "enabled": true
  },
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": [
      "before 4am on monday"
    ]
  },
  "packageRules": [
    {
      "matchManagers": [
        "poetry"
      ],
      "rangeStrategy": "bump"
    },
    {
      "matchPackageNames": [
        "*"
      ],
      "groupName": "all dependencies",
      "groupSlug": "all-deps"
    }
  ]
}
